    "# New features for the test data\n",
    "test_data['group_id'] = test_data['PassengerId'].str[:4]\n",
    "\n",
    "group_sizes = test_data.groupby('group_id').size()\n",
    "test_data['group_size'] = test_data['group_id'].map(group_sizes)\n",
    "\n",
    "test_data['is_alone'] = (test_data['group_size'] == 1).astype(int)  # 1/0 for model\n",
    "\n",
    "amenities = ['RoomService', 'FoodCourt', 'ShoppingMall', 'Spa', 'VRDeck']\n",
    "test_data['total_spend'] = test_data[amenities].sum(axis=1)\n",
    "\n",
    "test_data['has_spend'] = (test_data['total_spend'] > 0).astype(int)\n",
    "\n",
    "test_data['age_bin'] = pd.cut(test_data['Age'], bins=[0, 12, 18, 50, 80], labels=['child', 'teen', 'adult', 'senior'])\n",
    "\n",
    "test_data.drop('group_id', axis=1, inplace=True)\n",
    "\n",
    "test_data[['PassengerId', 'group_size', 'is_alone', 'total_spend', 'has_spend', 'age_bin']].head()"
