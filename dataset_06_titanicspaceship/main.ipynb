   "source": [
    "# Creating new features\n",
    "train_data['group_id'] = train_data['PassengerId'].str[:4]\n",
    "\n",
    "group_sizes = train_data.groupby('group_id').size()\n",
    "train_data['group_size'] = train_data['group_id'].map(group_sizes)\n",
    "\n",
    "train_data['is_alone'] = (train_data['group_size'] == 1).astype(int)  # 1/0 for model\n",
    "\n",
    "amenities = ['RoomService', 'FoodCourt', 'ShoppingMall', 'Spa', 'VRDeck']\n",
    "train_data['total_spend'] = train_data[amenities].sum(axis=1)\n",
    "\n",
    "train_data['has_spend'] = (train_data['total_spend'] > 0).astype(int)\n",
    "\n",
    "train_data['age_bin'] = pd.cut(train_data['Age'], bins=[0, 12, 18, 50, 80], labels=['child', 'teen', 'adult', 'senior'])\n",
    "\n",
    "train_data.drop('group_id', axis=1, inplace=True)\n",
    "\n",
    "train_data[['PassengerId', 'group_size', 'is_alone', 'total_spend', 'has_spend', 'age_bin']].head()"
   ]
  },
