   "outputs": [],
   "source": [
    "class CabinTransformer(BaseEstimator, TransformerMixin):\n",
    "    def fit(self, X, y=None):\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        X = X.copy()\n",
    "        X[['deck', 'num', 'side']] = X['Cabin'].str.split('/', expand=True)\n",
    "        X['num'] = pd.to_numeric(X['num'], errors='coerce')\n",
    "        return X.drop('Cabin', axis=1)\n",
    "\n",
    "class TitanicPreprocessor(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self):\n",
    "        self.cabin_transformer = CabinTransformer()\n",
    "        self.num_cols = ['Age', 'RoomService', 'FoodCourt', 'ShoppingMall', 'Spa', 'VRDeck',\n",
    "                         'group_size', 'total_spend', 'is_alone', 'has_spend']\n",
    "        self.cat_cols = ['HomePlanet', 'Destination', 'VIP', 'CryoSleep', 'age_bin']\n",
    "\n",
    "        self.num_pipeline = Pipeline([\n",
    "            ('imputer', SimpleImputer(strategy='median')),\n",
    "            ('scaler', StandardScaler())\n",
    "        ])\n",
    "\n",
    "        self.cat_pipeline = Pipeline([\n",
    "            ('imputer', SimpleImputer(strategy='most_frequent')),\n",
    "            ('encoder', OneHotEncoder(handle_unknown='ignore', sparse_output=False))\n",
    "        ])\n",
    "\n",
    "        self.cabin_post = ColumnTransformer([\n",
    "            ('num_cabin', self.num_pipeline, ['num']),\n",
    "            ('cat_cabin', self.cat_pipeline, ['deck', 'side'])\n",
    "        ])\n",
    "\n",
    "        self.preprocessor = ColumnTransformer([\n",
    "            ('num', self.num_pipeline, self.num_cols),\n",
    "            ('cat', self.cat_pipeline, self.cat_cols),\n",
    "            ('cabin', Pipeline([('split', self.cabin_transformer), \n",
    "                                ('post', self.cabin_post)]), ['Cabin'])\n",
    "        ], remainder='drop')\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        self.preprocessor.fit(X)\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        X = X.copy()\n",
    "        amenities = ['RoomService', 'FoodCourt', 'ShoppingMall', 'Spa', 'VRDeck']\n",
    "        cryo_mask = X['CryoSleep'].fillna(False) == True\n",
    "        X.loc[cryo_mask, amenities] = X.loc[cryo_mask, amenities].fillna(0)\n",
    "        return self.preprocessor.transform(X)"
   ]
  },
